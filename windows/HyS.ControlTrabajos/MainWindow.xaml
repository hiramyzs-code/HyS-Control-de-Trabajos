<Window x:Class="HyS.ControlTrabajos.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HyS Control de Trabajos" Height="760" Width="1180" MinHeight="650" MinWidth="950" Background="#F5F8FC" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0A3070"><StackPanel Margin="22,30"><TextBlock Text="HyS" Foreground="White" FontSize="36" FontWeight="Bold"/><TextBlock Text="CONTROL DE TRABAJOS" Foreground="#BFD7FF" FontSize="13" Margin="0,4,0,32"/><Button Content="Inicio" Height="45" Margin="0,0,0,8"/><Button Content="Trabajos actuales" Height="45" Margin="0,0,0,8"/><Button Content="Historial semanal" Height="45" Margin="0,0,0,8"/><Button Content="Buscar trabajo" Height="45" Margin="0,0,0,8"/><Button Content="Configuración" Height="45"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Control de Trabajos" FontSize="32" FontWeight="Bold" Foreground="#0A3070"/><TextBlock Text="ORGANIZA  •  REGISTRA  •  DA SEGUIMIENTO" Foreground="#6F87AE" Margin="0,5,0,20"/></StackPanel>
<Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Button Content="＋ NUEVO TRABAJO" Width="180" Height="48" Margin="0,0,10,0" Click="NewJob_Click"/><Button Grid.Column="1" Content="EXPORTAR REPORTE" Width="170" Height="48"/><Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,10"><StackPanel><TextBlock Text="TOTAL FACTURABLE (TERMINADOS)" FontSize="12" Foreground="#4B6796"/><TextBlock x:Name="TotalText" Text="$0.00" FontSize="25" FontWeight="Bold" Foreground="#0C3EAA"/></StackPanel></Border></Grid>
<Border Grid.Row="2" Background="White" CornerRadius="14" Padding="18"><DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/><DataGridTextColumn Header="Área / Lugar" Binding="{Binding Area}" Width="180"/><DataGridTextColumn Header="Trabajo realizado" Binding="{Binding Work}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Border>
</Grid></Grid></Window>
