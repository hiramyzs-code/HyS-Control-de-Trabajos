<Window x:Class="HyS.ControlTrabajos.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HyS - Control de trabajos" Width="1180" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F3F6F8">
<Grid><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="{StaticResource HySDark}"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="12" Background="White" VerticalAlignment="Center"><TextBlock Text="HyS" FontWeight="Bold" FontSize="22" Foreground="{StaticResource HySBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="Control de trabajos" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Tecnología, servicio y confianza" Foreground="#BFD1DD" FontSize="13"/></StackPanel><TextBlock Grid.Column="2" Text="Windows" Foreground="White" VerticalAlignment="Center" FontSize="14"/></Grid></Border>
<Grid Grid.Row="1" Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="14" Padding="18"><StackPanel><Button Content="＋ Nuevo trabajo" Height="44" Margin="0,0,0,18" Background="{StaticResource HySBlue}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="NewJob_Click"/><TextBlock Text="TRABAJOS" FontSize="11" FontWeight="Bold" Foreground="#70808B" Margin="4,0,0,8"/><RadioButton x:Name="PendingRadio" Content="Pendientes" IsChecked="True" Margin="4,9" FontSize="15" Checked="Filter_Changed"/><RadioButton x:Name="DoneRadio" Content="Terminados" Margin="4,9" FontSize="15" Checked="Filter_Changed"/><Separator Margin="0,16"/><TextBlock Text="SINCRONIZACIÓN" FontSize="11" FontWeight="Bold" Foreground="#70808B" Margin="4,0,0,8"/><TextBlock x:Name="SyncStatus" Text="Base en la nube preparada" TextWrapping="Wrap" Margin="4,6" Foreground="#426273"/></StackPanel></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SectionTitle" Text="Trabajos pendientes" FontSize="25" FontWeight="SemiBold" Foreground="#19384C"/><TextBlock Text="Administra los trabajos desde tu computadora" Foreground="#70808B" Margin="0,5,0,0"/></StackPanel><TextBox Grid.Column="1" x:Name="SearchBox" Height="38" VerticalAlignment="Center" Padding="10,8" TextChanged="SearchBox_TextChanged" ToolTip="Buscar"/></Grid>
<Border Grid.Row="2" Background="White" CornerRadius="14" Padding="10"><DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" RowHeight="46" MouseDoubleClick="JobsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding WorkDate}" Width="110"/><DataGridTextColumn Header="Área de trabajo" Binding="{Binding Area}" Width="180"/><DataGridTextColumn Header="Trabajo realizado" Binding="{Binding Work}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid></Border></Grid></Grid></Grid></Window>