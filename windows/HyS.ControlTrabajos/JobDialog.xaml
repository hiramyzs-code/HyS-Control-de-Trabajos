<Window x:Class="HyS.ControlTrabajos.JobDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nuevo trabajo" Height="510" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FC"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Nuevo trabajo" FontSize="28" FontWeight="Bold" Foreground="#0A3070" Margin="0,0,0,18"/><StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Fecha"/><TextBox x:Name="DateBox" Height="34"/></StackPanel><StackPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="Área de trabajo / lugar"/><TextBox x:Name="AreaBox" Height="34"/></StackPanel><StackPanel Grid.Row="3" Margin="0,0,0,12"><TextBlock Text="Trabajo realizado"/><TextBox x:Name="WorkBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Importe"/><TextBox x:Name="AmountBox" Height="34"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Estado"/><ComboBox x:Name="StatusBox" Height="34" SelectedIndex="0"><ComboBoxItem Content="Pendiente"/><ComboBoxItem Content="Terminado"/><ComboBoxItem Content="Cancelado"/></ComboBox></StackPanel></Grid><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0"><Button Content="Cancelar" Width="105" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Guardar" Width="125" Height="40" Click="Save_Click"/></StackPanel></Grid></Window>