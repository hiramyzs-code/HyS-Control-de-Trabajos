<Window x:Class="HyS.ControlTrabajos.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HyS - Iniciar sesión" Height="420" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F7FA">
<Grid Margin="42"><Border Background="White" CornerRadius="16" Padding="30"><StackPanel><TextBlock Text="HyS" FontSize="36" FontWeight="Bold" Foreground="#0B4F8A" HorizontalAlignment="Center"/><TextBlock Text="Control de Trabajos" FontSize="20" Margin="0,4,0,24" HorizontalAlignment="Center"/><TextBlock Text="Correo"/><TextBox x:Name="EmailBox" Height="36" Margin="0,6,0,14"/><TextBlock Text="Contraseña"/><PasswordBox x:Name="PasswordBox" Height="36" Margin="0,6,0,22"/><Button Content="INICIAR SESIÓN" Height="42" Background="#0B4F8A" Foreground="White" FontWeight="Bold" Click="Login_Click"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#B3261E" HorizontalAlignment="Center"/></StackPanel></Border></Grid></Window>